{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Orlyscript",
  "scopeName": "source.orly",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#parameters" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.orly",
          "match": "//.*$"
        },
        {
          "name": "comment.block.orly",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.orly",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.orly",
              "match": "\\\\(?:[\\\\\"'abfnrtv]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.orly",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.orly",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.orly",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.orly",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.orly",
          "match": "\\b(unknown|known)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.orly",
          "match": "\\b(if|else|else_if|while|start|try)\\b"
        },
        {
          "name": "keyword.declaration.orly",
          "match": "\\b(package|import|test|given|where|effecting|assert)\\b"
        },
        {
          "name": "keyword.operator.query.orly",
          "match": "\\b(keys|take|skip|reduce|sorted_by|reversed|filter|split|collated_by|collected_by|having|that|to|from)\\b"
        },
        {
          "name": "keyword.operator.mutation.orly",
          "match": "\\b(new|mutate|delete|mut)\\b"
        },
        {
          "name": "keyword.operator.type.orly",
          "match": "\\b(as|is|in|opt|empty|free)\\b"
        },
        {
          "name": "keyword.operator.logical.orly",
          "match": "\\b(not|xor)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.orly",
          "match": "\\b(bool|int|real|str|time_pnt|time_diff|id|addr)\\b"
        },
        {
          "name": "support.type.collection.orly",
          "match": "\\b(dict|list|set)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.orly",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.orly",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.channel.orly",
          "match": "(<-|->)"
        },
        {
          "name": "keyword.operator.scope.orly",
          "match": "::"
        },
        {
          "name": "keyword.operator.assignment.orly",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.orly" }
          }
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "variable.parameter.orly" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.orly",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}

/* <examples/grc20-pov/versioned.orly>

   The GRC-20-shaped graph again, on native versioned reads (#745).

   grc20.orly keeps every op as an event in a per-(entity, property) history
   set and replays it, filtered to a timestamp, to answer "what did this say
   then". This model keeps only the *current* value of each (entity,
   property) as a plain key: a write overwrites it, a delete removes it. The
   engine keeps the past. A client reads the same methods at an earlier
   version of the global POV (`try {pov} at V ...`, `at time "..."`,
   `at save "..."`; needs a server started with --retention_seconds or
   --retention_versions), and gets the graph as it stood then, with no
   timestamp in the data and no replay in the model.

   The trade: the history is the engine's, bounded by its retention window,
   and it records what the key held, not who wrote it. grc20.orly's event log
   is forever and carries the editor of every claim; this one is for "what
   did it say last week" over a window you choose.

   ## Schema

     <['val', entity, property]>::(op_t)   the current value, absent if unset

   Copyright 2010-2026 Atomic Kismet Company

   Licensed under the Apache License, Version 2.0 (the "License");
   you may not use this file except in compliance with the License.
   You may obtain a copy of the License at

     http://www.apache.org/licenses/LICENSE-2.0

   Unless required by applicable law or agreed to in writing, software
   distributed under the License is distributed on an "AS IS" BASIS,
   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
   See the License for the specific language governing permissions and
   limitations under the License. */

package #1;

/* One GRC-20 value as a tagged union. There is no tombstone arm: removing a
   property deletes its key, and the engine remembers it was there. */
op_t is <| Text(str) | Number(int) | Relation(str) |>;

/* ---------- writes ---------- */

set_text = ((true) effecting {
  new <['val', entity, property]> <- <| Text(str) | Number(int) | Relation(str) |>.Text(text);
}) where {
  entity   = given::(str);
  property = given::(str);
  text     = given::(str);
};

set_number = ((true) effecting {
  new <['val', entity, property]> <- <| Text(str) | Number(int) | Relation(str) |>.Number(n);
}) where {
  entity   = given::(str);
  property = given::(str);
  n        = given::(int);
};

set_relation = ((true) effecting {
  new <['val', entity, property]> <- <| Text(str) | Number(int) | Relation(str) |>.Relation(target);
}) where {
  entity   = given::(str);
  property = given::(str);
  target   = given::(str);
};

clear_prop = ((true) effecting {
  delete (op_t) @ <['val', entity, property]>;
}) where {
  entity   = given::(str);
  property = given::(str);
};

/* ---------- reads ---------- */

show = ((op) when {
  Text:     op.Text;
  Number:   (op.Number) as str;
  Relation: "-> " + op.Relation;
}) where {
  op = given::(op_t);
};

/* One property's value, formatted; "(absent)" when it is not set. */
display = (((show(.op: *<['val', entity, property]>::(op_t))) if *<['val', entity, property]>::(op_t?) is known else ("(absent)"))) where {
  entity   = given::(str);
  property = given::(str);
};

row = (<{.property: k.2, .value: show(.op: *k::(op_t))}>) where {
  k = given::(<[str, str, str]>);
};

/* Every property an entity has, formatted, in property order. */
snapshot = (row(.k: keys (op_t) @ <['val', entity, free::(str)]>) as [<{.property: str, .value: str}>]) where {
  entity = given::(str);
};

test {
  t1: display(.entity: "plato", .property: "name") == "(absent)";
  t2: snapshot(.entity: "plato") == empty [<{.property: str, .value: str}>];

  t3: set_text(.entity: "plato", .property: "name", .text: "Plato") {
    t4: display(.entity: "plato", .property: "name") == "Plato";
    t5: set_text(.entity: "plato", .property: "name", .text: "Plato of Athens") {
      t6: display(.entity: "plato", .property: "name") == "Plato of Athens";
      t7: set_number(.entity: "plato", .property: "born", .n: -428) {
        t8: set_relation(.entity: "plato", .property: "student_of", .target: "socrates") {
          t9: snapshot(.entity: "plato") == [
            <{.property: "born", .value: "-428"}>,
            <{.property: "name", .value: "Plato of Athens"}>,
            <{.property: "student_of", .value: "-> socrates"}>];
          t10: clear_prop(.entity: "plato", .property: "born") {
            t11: display(.entity: "plato", .property: "born") == "(absent)";
            t12: snapshot(.entity: "plato") == [
              <{.property: "name", .value: "Plato of Athens"}>,
              <{.property: "student_of", .value: "-> socrates"}>];
          };
        };
      };
    };
  };
};

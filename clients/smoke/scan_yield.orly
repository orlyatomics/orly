package #1;
/* Scan-yield smoke (#1015): rows in one prefix, a scan over all of them, and a point read. */
put = ((true) effecting { new <['r', n]> <- n; }) where { n = given::(int); };
get = (*<['r', n]>::(int?)) where { n = given::(int); };
/* Walks every row: the filter keeps it off the CountKeys fast path, which answers a bare count without one. */
count_all = ((keys (int) @ <['r', free::(int)]> if that.1 >= 0) reduce start 0 + 1);

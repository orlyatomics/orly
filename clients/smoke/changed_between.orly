   See the License for the specific language governing permissions and
   limitations under the License. */

package #1;

/* Store edge `e` of group `g`, weighing `w`. */
put = ((true) effecting {
  new <['edge', g, e]> <- w;
}) where {
  g = given::(int);
  e = given::(int);
  w = given::(int);
};

/* Delete edge `e` of group `g`. */
remove = ((true) effecting {
  delete (int) @ <['edge', g, e]>;
}) where {
  g = given::(int);
  e = given::(int);
};

/* The edges of group `g` whose weight differs between versions `a` and `b`, or that exist at
   only one of them. The test runner reads a child POV, which `changed between` refuses, so this
   package has no test block; run-changed-between.sh runs it against the global POV. */
edges_changed = ((row(.k: keys (int) @ <['edge', g, free::(int)]> changed between (a, b)) as [<{.e: int}>])) where {
  g = given::(int);
  a = given::(int);
  b = given::(int);
};

/* The same, after edge `last`. */
edges_changed_after = (row(.k: keys (int) @ <['edge', g, free::(int)]> changed between (a, b) after <['edge', g, last]>) as [<{.e: int}>]) where {
  g = given::(int);
  a = given::(int);
  b = given::(int);
  last = given::(int);
};

/* One row: the edge. A key's value is not read, since a key deleted since the later version has none to read. */
row = (<{.e: k.2}>) where {
  k = given::(<[str, int, int]>);
};

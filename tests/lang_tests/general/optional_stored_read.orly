/* <orly/lang_tests/general/optional_stored_read.orly>

   End-to-end test for issue #979: a value written as an optional
   (`<[k]> <- x as T?`) is stored as one, and a read as `T?` gives it back,
   known or not.  This used to fail with "Unable to convert sabot to given
   native type" for every `T`; the issue reported it for recursive variants.
   A value written as a plain `T` and read as `T?` still reads as known, and
   a missing key still reads as unknown.

   Copyright 2010-2026 Atomic Kismet Company

   Licensed under the Apache License, Version 2.0 (the "License");
   you may not use this file except in compliance with the License.
   You may obtain a copy of the License at

     http://www.apache.org/licenses/LICENSE-2.0

   Unless required by applicable law or agreed to in writing, software
   distributed under the License is distributed on an "AS IS" BASIS,
   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
   See the License for the specific language governing permissions and
   limitations under the License. */

nd is <| L | N(nd) |>;
v is <| X | Y(int) |>;
fa is <| A0 | A1(fb) |>;
fb is <| B0 | B1(fa) |>;

read_int = (*<[n]>::(int?)) where { n = given::(int); };
read_v = (*<[n]>::(v?)) where { n = given::(int); };
read_nd = (*<[n]>::(nd?)) where { n = given::(int); };
read_fa = (*<[n]>::(fa?)) where { n = given::(int); };

/* The repro from the issue. */
with {
  <[1]> <- nd.N(nd.L()) as nd?;
} test {
  t1: known read_nd(.n: 1) == nd.N(nd.L());
};

/* Recursive and mutually recursive variants. */
with {
  <[1]> <- nd.L() as nd?;
  <[2]> <- nd.N(nd.N(nd.L())) as nd?;
  <[3]> <- nd.N(nd.L());
  <[4]> <- fa.A1(fb.B1(fa.A0())) as fa?;
} test {
  t2: known read_nd(.n: 1) == nd.L();
  t3: known read_nd(.n: 2) == nd.N(nd.N(nd.L()));
  t4: known read_nd(.n: 3) == nd.N(nd.L());
  t5: read_nd(.n: 5) is unknown;
  t6: known read_fa(.n: 4) == fa.A1(fb.B1(fa.A0()));
};

/* A plain variant and a scalar. */
with {
  <[1]> <- v.Y(3) as v?;
  <[2]> <- v.X();
  <[3]> <- 5 as int?;
  <[4]> <- unknown int;
  <[5]> <- 6;
} test {
  t7: known read_v(.n: 1) == v.Y(3);
  t8: known read_v(.n: 2) == v.X();
  t9: known read_int(.n: 3) == 5;
  t10: read_int(.n: 4) is unknown;
  t11: known read_int(.n: 5) == 6;
  t12: read_int(.n: 6) is unknown;
};

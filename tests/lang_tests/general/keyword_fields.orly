fields is <{.id: int, .to: str, .from: int, .start: int, .after: int,
            .if: bool, .true: bool, .int: int, .and: bool, .keys: str,
            .where: bool}>;
row = <{.id: 7, .to: "target", .from: 2, .start: 3, .after: 4,
        .if: true, .true: false, .int: 5, .and: true, .keys: "record",
        .where: true}>;
read_id = (value.id) where { value = given::(fields); };
read_to = (value.to) where { value = given::(fields); };
echo_row = (value) where { value = given::(fields); };

test {
  id_field: row.id == 7;
  to_field: row.to == "target";
  from_field: row.from == 2;
  start_field: row.start == 3;
  after_field: row.after == 4;
  if_field: row.if == true;
  true_field: row.true == false;
  int_field: row.int == 5;
  and_field: row.and and row.if;
  keys_field: row.keys == "record";
  where_field: row.where == true;
  literal_access: <{.id: 8, .to: 9}>.id + <{.to: 9}>.to == 17;
  typed_id: read_id(.value: row) == 7;
  typed_to: read_to(.value: row) == "target";
  typed_round_trip: echo_row(.value: row) == row;
  nested: <{.to: <{.id: 10}>}>.to.id == 10;
  ordinary_name: <{.id_suffix: 11}>.id_suffix == 11;
  tuple_access: <[12, 13]>.0 == 12;
  trivia: <{. /* field */ id: 14}>. /* access */ id == 14;
  precedence: row.id + row.start * row.from == 13;
  keyword_operator: row.if and not row.true;
};

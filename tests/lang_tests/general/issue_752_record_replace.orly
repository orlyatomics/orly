package #1;
p_t is <{.a: str, .b: int}>;
put = (((true) effecting {
  *<['k', k]>::(p_t) <- v;
} if *<['k', k]>::(p_t?) is known else (true) effecting {
  new <['k', k]> <- v;
})) where {
  k = given::(str);
  v = given::(p_t);
};
get = (*<['k', k]>::(p_t)) where { k = given::(str); };
test {
  t1: put(.k: "x", .v: <{.a: "one", .b: 1}>) {
    t2: put(.k: "x", .v: <{.a: "two", .b: 2}>) {
      t3: get(.k: "x").a == "two";
      t4: get(.k: "x").b == 2;
      t5: (true) effecting {
        *<['k', "x"]>::(p_t) <- <{.a: "three", .b: 3}>;
      } {
        t6: get(.k: "x") == <{.a: "three", .b: 3}>;
      };
    };
  };
};

outer_t is <{.inner: p_t, .keep: int}>;
with {
  <['nested']> <- <{.inner: <{.a: "one", .b: 1}>, .keep: 10}>;
} test {
  t10: (true) effecting {
    *<['nested']>::(outer_t).inner <- <{.a: "two", .b: 2}>;
  } {
    t11: *<['nested']>::(outer_t) ==
      <{.inner: <{.a: "two", .b: 2}>, .keep: 10}>;
    t12: (true) effecting {
      *<['nested']>::(outer_t) <-
        <{.inner: <{.a: "three", .b: 3}>, .keep: 20}>;
    } {
      t13: *<['nested']>::(outer_t) ==
        <{.inner: <{.a: "three", .b: 3}>, .keep: 20}>;
    };
  };
};

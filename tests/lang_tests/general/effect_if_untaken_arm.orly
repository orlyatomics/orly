   See the License for the specific language governing permissions and
   limitations under the License. */

put = ((there) effecting {
  if there {
    *<['k', k]>::(int) <- v;
  } else {
    new <['k', k]> <- v;
  }
}) where {
  there = *<['k', k]>::(int?) is known;
  k = given::(int);
  v = given::(int);
};

nested = ((true) effecting {
  if first {
    if second {
      *<['n', k]>::(int) <- v;
    } else {
      new <['n', k]> <- v;
    }
  } else {
    *<['m', k]>::(int) <- v;
  }
}) where {
  first = k > 0;
  second = *<['n', k]>::(int?) is known;
  k = given::(int);
  v = given::(int);
};

test {
  t1: put(.k: 1, .v: 10) == false {
    t2: *<['k', 1]>::(int) == 10;
    t3: put(.k: 1, .v: 20) == true {
      t4: *<['k', 1]>::(int) == 20;
    };
  };
  t5: nested(.k: 1, .v: 5) {
    t6: *<['n', 1]>::(int) == 5;
  };
};

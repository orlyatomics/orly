   See the License for the specific language governing permissions and
   limitations under the License. */

leaf_t is <| Leaf(int) | Node([leaf_t]) |>;
inner_t is <| A(int) | B |>;
rec_t is <{.name: str, .n: int}>;
par_t is <| Bool(bool) | Dict({str: rec_t}) | Empty | Ident(id) | Int(int) | Nested(inner_t) | Rec(rec_t) | Recur(leaf_t) | Set({rec_t}) | Str(str) | TD(time_diff) | TP(time_pnt) | X_u(int) | Xa(int) | xb(int) |>;
get = (*<[k, 1]>::(par_t)) where {
  k = given::(par_t);
};
